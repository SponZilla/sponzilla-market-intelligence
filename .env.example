NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sponzilla
OPENAI_API_KEY=
# Production should use an official API provider.
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
BRAVE_API_KEY=
RESEARCH_API_KEY=
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# --- AutoGTM handoff -------------------------------------------------------
# Where a completed research run posts its OpportunityV1 payload.
# Local:    http://127.0.0.1:3000/api/v1/opportunities/ingest
# Deployed: https://<gtm-host>/api/v1/opportunities/ingest
GTM_INGEST_URL=http://127.0.0.1:3000/api/v1/opportunities/ingest

# Must equal the GTM service INTERNAL_ADMIN_API_KEY.
INTERNAL_ADMIN_API_KEY=

# Set to false to stop posting research results into AutoGTM.
ENABLE_GTM_AUTO_HANDOFF=true

# User id forwarded as X-Operator-Id so the generated card belongs to the person
# who asked for the research. Empty means GTM falls back to GTM_DEFAULT_OWNER_ID,
# and a card with neither is owned by nobody and invisible in the pipeline.
GTM_OPERATOR_ID=
